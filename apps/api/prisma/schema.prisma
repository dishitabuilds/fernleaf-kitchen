generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

model StaffUser {
  id                     String         @id @default(uuid()) @db.Uuid
  email                  String         @unique @db.VarChar(254)
  displayName            String         @db.VarChar(100)
  passwordHash           String         @db.VarChar(255)
  role                   StaffRole
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  sessions               Session[]
  defaultDriverCompanies Company[]
  deliveryDrops          DeliveryDrop[]
}

enum ReferenceKind {
  ALLERGEN
  DIETARY_TAG
  KITCHEN_STATION
  PORTION_SIZE
  PACKAGING_TYPE
  PUBLIC_EMAIL_DOMAIN
}

enum FoodTemperature {
  HOT
  COLD
  AMBIENT
}

enum PriceRule {
  MANUAL
  COST
  REFERENCE
}

model ReferenceValue {
  id                String               @id @default(uuid()) @db.Uuid
  kind              ReferenceKind
  name              String               @db.VarChar(254)
  active            Boolean              @default(true)
  sortOrder         Int                  @default(0)
  stations          Dish[]               @relation("DishStation")
  companies         Company[]            @relation("CompanyPackaging")
  dishAllergens     DishAllergen[]
  dishTags          DishDietaryTag[]
  optionAllergens   OptionAllergen[]
  optionTags        OptionDietaryTag[]
  employeeAllergens EmployeeAllergen[]
  employeeTags      EmployeeDietaryTag[]

  @@unique([kind, name])
}

model Dish {
  id          String            @id @default(uuid()) @db.Uuid
  sku         String            @unique @db.VarChar(80)
  name        String            @db.VarChar(150)
  description String            @default("") @db.VarChar(2000)
  imageUrl    String?           @db.VarChar(2048)
  temperature FoodTemperature   @default(HOT)
  costMinor   Int               @default(0)
  stationId   String?           @db.Uuid
  station     ReferenceValue?   @relation("DishStation", fields: [stationId], references: [id], onDelete: Restrict)
  minQuantity Int?
  active      Boolean           @default(true)
  allergens   DishAllergen[]
  dietaryTags DishDietaryTag[]
  groups      DishOptionGroup[]
  menuItems   MenuItem[]
  prices      DishTierPrice[]
  orderLines  OrderLine[]
}

model Option {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(150)
  description String             @default("") @db.VarChar(2000)
  costMinor   Int                @default(0)
  active      Boolean            @default(true)
  allergens   OptionAllergen[]
  dietaryTags OptionDietaryTag[]
  groups      GroupOption[]
  prices      OptionTierPrice[]
}

model DishAllergen {
  dishId      String         @db.Uuid
  referenceId String         @db.Uuid
  dish        Dish           @relation(fields: [dishId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([dishId, referenceId])
}

model DishDietaryTag {
  dishId      String         @db.Uuid
  referenceId String         @db.Uuid
  dish        Dish           @relation(fields: [dishId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([dishId, referenceId])
}

model OptionAllergen {
  optionId    String         @db.Uuid
  referenceId String         @db.Uuid
  option      Option         @relation(fields: [optionId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([optionId, referenceId])
}

model OptionDietaryTag {
  optionId    String         @db.Uuid
  referenceId String         @db.Uuid
  option      Option         @relation(fields: [optionId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([optionId, referenceId])
}

model DishOptionGroup {
  id        String        @id @default(uuid()) @db.Uuid
  dishId    String        @db.Uuid
  dish      Dish          @relation(fields: [dishId], references: [id], onDelete: Restrict)
  name      String        @db.VarChar(150)
  required  Boolean       @default(false)
  sortOrder Int           @default(0)
  options   GroupOption[]

  @@index([dishId, sortOrder])
}

model GroupOption {
  groupId   String          @db.Uuid
  optionId  String          @db.Uuid
  group     DishOptionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  option    Option          @relation(fields: [optionId], references: [id], onDelete: Restrict)
  sortOrder Int             @default(0)

  @@id([groupId, optionId])
}

model Category {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String                  @db.VarChar(150)
  active    Boolean                 @default(true)
  secret    Boolean                 @default(false)
  sortOrder Int                     @default(0)
  items     MenuItem[]
  hiddenFor CompanyHiddenCategory[]
}

model MenuItem {
  id         String                  @id @default(uuid()) @db.Uuid
  categoryId String                  @db.Uuid
  dishId     String                  @db.Uuid
  category   Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dish       Dish                    @relation(fields: [dishId], references: [id], onDelete: Restrict)
  active     Boolean                 @default(true)
  sortOrder  Int                     @default(0)
  hiddenFor  CompanyHiddenMenuItem[]

  @@unique([categoryId, dishId])
  @@index([categoryId, sortOrder])
}

model PriceTier {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @unique @db.VarChar(150)
  rule            PriceRule         @default(MANUAL)
  numerator       Int               @default(1)
  denominator     Int               @default(1)
  referenceTierId String?           @db.Uuid
  referenceTier   PriceTier?        @relation("TierReference", fields: [referenceTierId], references: [id], onDelete: Restrict)
  dependents      PriceTier[]       @relation("TierReference")
  active          Boolean           @default(true)
  dishPrices      DishTierPrice[]
  optionPrices    OptionTierPrice[]
  companies       Company[]
  settings        KitchenSettings[]
}

model DishTierPrice {
  tierId      String    @db.Uuid
  dishId      String    @db.Uuid
  amountMinor Int
  tier        PriceTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([tierId, dishId])
}

model OptionTierPrice {
  tierId      String    @db.Uuid
  optionId    String    @db.Uuid
  amountMinor Int
  tier        PriceTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  option      Option    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([tierId, optionId])
}

model KitchenSettings {
  id                   Int       @id @default(1)
  timezone             String    @default("Asia/Kolkata") @db.VarChar(40)
  currency             String    @default("USD") @db.Char(3)
  defaultPriceTierId   String    @db.Uuid
  defaultPriceTier     PriceTier @relation(fields: [defaultPriceTierId], references: [id], onDelete: Restrict)
  workingDays          Int[]     @default([1, 2, 3, 4, 5])
  holidays             String[]  @default([])
  cutoffTime           String    @default("16:00") @db.VarChar(5)
  cutoffWorkingDays    Int       @default(2)
  riskThresholdMinutes Int       @default(15)
  version              Int       @default(1)
}

model Company {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String                  @db.VarChar(150)
  billingName        String                  @db.VarChar(150)
  billingEmail       String                  @db.VarChar(254)
  billingAddress     String                  @db.VarChar(1000)
  billingContactName String                  @db.VarChar(150)
  phone              String?                 @db.VarChar(40)
  active             Boolean                 @default(true)
  ownerEmployeeId    String?                 @db.Uuid
  owner              Employee?               @relation("CompanyOwner", fields: [ownerEmployeeId, id], references: [id, companyId], onDelete: Restrict, onUpdate: NoAction)
  defaultAddressId   String?                 @db.Uuid
  defaultAddress     CompanyAddress?         @relation("DefaultAddress", fields: [defaultAddressId, id], references: [id, companyId], onDelete: Restrict, onUpdate: NoAction)
  priceTierId        String?                 @db.Uuid
  priceTier          PriceTier?              @relation(fields: [priceTierId], references: [id], onDelete: Restrict)
  deliveryTime       String                  @default("12:30") @db.VarChar(5)
  deliveryMinutes    Int                     @default(60)
  packagingId        String?                 @db.Uuid
  packaging          ReferenceValue?         @relation("CompanyPackaging", fields: [packagingId], references: [id], onDelete: Restrict)
  defaultDriverId    String?                 @db.Uuid
  defaultDriver      StaffUser?              @relation(fields: [defaultDriverId], references: [id], onDelete: Restrict)
  driverInstructions String                  @default("") @db.VarChar(2000)
  workingDays        Int[]                   @default([1, 2, 3, 4, 5])
  holidays           String[]                @default([])
  version            Int                     @default(1)
  domains            CompanyDomain[]
  addresses          CompanyAddress[]        @relation("CompanyAddresses")
  employees          Employee[]              @relation("CompanyEmployees")
  hiddenCategories   CompanyHiddenCategory[]
  hiddenItems        CompanyHiddenMenuItem[]
  orders             Order[]
  deliveryDrops      DeliveryDrop[]
  invoices           Invoice[]

  @@unique([ownerEmployeeId, id])
  @@unique([defaultAddressId, id])
}

model CompanyDomain {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  domain    String  @unique @db.VarChar(254)
}

model CompanyAddress {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  company           Company  @relation("CompanyAddresses", fields: [companyId], references: [id], onDelete: Restrict)
  label             String   @db.VarChar(100)
  line1             String   @db.VarChar(250)
  line2             String?  @db.VarChar(250)
  city              String   @db.VarChar(100)
  region            String   @db.VarChar(100)
  postalCode        String   @db.VarChar(30)
  country           String   @db.VarChar(100)
  active            Boolean  @default(true)
  defaultForCompany Company? @relation("DefaultAddress")

  @@unique([id, companyId])
}

model Employee {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  company            Company              @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Restrict)
  email              String               @db.VarChar(254)
  name               String               @db.VarChar(150)
  phone              String?              @db.VarChar(40)
  active             Boolean              @default(true)
  canChooseAddress   Boolean              @default(false)
  canChangeTime      Boolean              @default(false)
  canChangePackaging Boolean              @default(false)
  ownerOfCompany     Company?             @relation("CompanyOwner")
  orders             Order[]
  allergens          EmployeeAllergen[]
  dietaryTags        EmployeeDietaryTag[]

  @@unique([id, companyId])
  @@unique([companyId, email])
  @@index([companyId, active])
}

model EmployeeAllergen {
  employeeId  String         @db.Uuid
  referenceId String         @db.Uuid
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([employeeId, referenceId])
}

model EmployeeDietaryTag {
  employeeId  String         @db.Uuid
  referenceId String         @db.Uuid
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reference   ReferenceValue @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@id([employeeId, referenceId])
}

model CompanyHiddenCategory {
  companyId  String   @db.Uuid
  categoryId String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([companyId, categoryId])
}

model CompanyHiddenMenuItem {
  companyId  String   @db.Uuid
  menuItemId String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@id([companyId, menuItemId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Uuid
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PrepStatus {
  PENDING
  STARTED
  DONE
}

enum DropStatus {
  AWAITING_KITCHEN
  KITCHEN_READY
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

model DeliveryDateCutoff {
  deliveryDate    String    @id @db.VarChar(10)
  cutoffAt        DateTime  @db.Timestamptz(3)
  settingsVersion Int
  policySnapshot  Json
  processedAt     DateTime? @db.Timestamptz(3)
  lastProcessedAt DateTime? @db.Timestamptz(3)
  orders          Order[]

  @@index([cutoffAt, processedAt])
}

model Order {
  id                     String             @id @default(uuid()) @db.Uuid
  number                 Int                @unique @default(autoincrement())
  employeeId             String             @db.Uuid
  employee               Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyId              String             @db.Uuid
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeName           String             @db.VarChar(150)
  companyName            String             @db.VarChar(150)
  employeeSnapshot       Json
  companySnapshot        Json
  deliveryDate           String             @db.VarChar(10)
  cutoff                 DeliveryDateCutoff @relation(fields: [deliveryDate], references: [deliveryDate], onDelete: Restrict)
  deliveryAt             DateTime           @db.Timestamptz(3)
  cutoffAt               DateTime           @db.Timestamptz(3)
  addressKey             String             @db.Char(64)
  deliverySnapshot       Json
  plannedDispatchReadyAt DateTime           @db.Timestamptz(3)
  plannedKitchenReadyAt  DateTime           @db.Timestamptz(3)
  input                  Json
  purchaseSnapshot       Json?
  totalMinor             Int?
  status                 OrderStatus        @default(DRAFT)
  version                Int                @default(1)
  createdById            String             @db.Uuid
  dropId                 String?            @db.Uuid
  drop                   DeliveryDrop?      @relation(fields: [dropId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: NoAction)
  placedAt               DateTime?          @db.Timestamptz(3)
  confirmedAt            DateTime?          @db.Timestamptz(3)
  cancelledAt            DateTime?          @db.Timestamptz(3)
  rejectedAt             DateTime?          @db.Timestamptz(3)
  deliveredAt            DateTime?          @db.Timestamptz(3)
  kitchenStartedAt       DateTime?          @db.Timestamptz(3)
  kitchenReadyAt         DateTime?          @db.Timestamptz(3)
  invoiceId              String?            @db.Uuid
  invoice                Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  lines                  OrderLine[]
  events                 OrderEvent[]
  revisions              OrderRevision[]
  actions                OrderAction[]
  credits                BillingCredit[]

  @@index([deliveryDate, status, companyId])
  @@index([status, cutoffAt])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([dropId])
  @@index([invoiceId])
}

model OrderLine {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @db.Uuid
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId         String             @db.Uuid
  dish           Dish               @relation(fields: [dishId], references: [id], onDelete: Restrict)
  menuItemId     String             @db.Uuid
  sortOrder      Int
  quantity       Int
  basePriceMinor Int
  totalMinor     Int
  dishSnapshot   Json
  combinations   OrderCombination[]

  @@unique([orderId, dishId])
  @@index([orderId, sortOrder])
}

model OrderCombination {
  id             String              @id @default(uuid()) @db.Uuid
  lineId         String              @db.Uuid
  line           OrderLine           @relation(fields: [lineId], references: [id], onDelete: Cascade)
  canonicalKey   String              @db.Char(64)
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  selections     SelectionSnapshot[]
  prepUnit       PrepUnit?

  @@unique([lineId, canonicalKey])
}

// Group/option IDs are historical identifiers, deliberately independent of live
// group rows, which catalogue administration may replace.
model SelectionSnapshot {
  id            String           @id @default(uuid()) @db.Uuid
  combinationId String           @db.Uuid
  combination   OrderCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  groupId       String           @db.Uuid
  groupName     String           @db.VarChar(150)
  optionId      String           @db.Uuid
  optionName    String           @db.VarChar(150)
  priceMinor    Int
  priceSource   String           @db.VarChar(20)
  tierId        String           @db.Uuid
  sortOrder     Int
  allergens     Json
  dietaryTags   Json

  @@index([combinationId, sortOrder])
}

model OrderRevision {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  actorId   String   @db.Uuid
  reason    String?  @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, version])
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sequence  Int      @unique @default(autoincrement())
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actionKey String   @db.VarChar(160)
  type      String   @db.VarChar(40)
  actorId   String?  @db.Uuid
  actorName String   @db.VarChar(150)
  reason    String?  @db.VarChar(2000)
  details   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, actionKey])
  @@index([orderId, createdAt])
}

model OrderAction {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  key         String   @db.VarChar(100)
  payloadHash String   @db.Char(64)
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  result      Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorId, key])
}

// Phase 2 creates pending work and drop membership at confirmation. Their
// operational board/actions are implemented in Phase 3.
model PrepUnit {
  id            String           @id @default(uuid()) @db.Uuid
  combinationId String           @unique @db.Uuid
  combination   OrderCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  stationId     String?          @db.Uuid
  stationName   String?          @db.VarChar(254)
  status        PrepStatus       @default(PENDING)
  version       Int              @default(1)
  startedAt     DateTime?        @db.Timestamptz(3)
  doneAt        DateTime?        @db.Timestamptz(3)

  @@index([stationId, status])
}

model DeliveryDrop {
  id                 String     @id @default(uuid()) @db.Uuid
  companyId          String     @db.Uuid
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveryDate       String     @db.VarChar(10)
  deliveryAt         DateTime   @db.Timestamptz(3)
  addressKey         String     @db.Char(64)
  addressSnapshot    Json
  driverInstructions String     @db.VarChar(2000)
  driverId           String?    @db.Uuid
  driver             StaffUser? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status             DropStatus @default(AWAITING_KITCHEN)
  version            Int        @default(1)
  kitchenReadyAt     DateTime?  @db.Timestamptz(3)
  dispatchReadyAt    DateTime?  @db.Timestamptz(3)
  departedAt         DateTime?  @db.Timestamptz(3)
  deliveredAt        DateTime?  @db.Timestamptz(3)
  targetAtDeparture  DateTime?  @db.Timestamptz(3)
  onTime             Boolean?
  note               String?    @db.VarChar(2000)
  photo              Bytes?
  photoMimeType      String?    @db.VarChar(50)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  orders             Order[]
  events             DropEvent[]

  @@unique([companyId, addressKey, deliveryAt])
  @@unique([id, companyId])
  @@index([driverId, deliveryDate, status])
  @@index([deliveryDate, status])
}

model DropEvent {
  id        String       @id @default(uuid()) @db.Uuid
  sequence  Int          @unique @default(autoincrement())
  dropId    String       @db.Uuid
  drop      DeliveryDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  actionKey String       @db.VarChar(160)
  type      String       @db.VarChar(40)
  actorId   String?      @db.Uuid
  actorName String       @db.VarChar(150)
  reason    String?      @db.VarChar(2000)
  details   Json
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([dropId, actionKey])
  @@index([dropId, createdAt])
}

// Successful operational responses are persisted in the same transaction as
// the transition. The actor/key pair is bound to its exact target and payload.
model OperationalAction {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  key         String   @db.VarChar(100)
  payloadHash String   @db.Char(64)
  result      Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorId, key])
}

model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  number           Int             @unique @default(autoincrement())
  companyId        String          @db.Uuid
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companySnapshot  Json            @default("{}")
  totalMinor       Int
  paidAmountMinor  Int             @default(0)
  issuedAt         DateTime        @default(now()) @db.Timestamptz(3)
  paidAt           DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  orders           Order[]
  credits          BillingCredit[]

  @@index([companyId, issuedAt])
}

model BillingCredit {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountMinor Int
  reason      String   @db.VarChar(2000)
  actionKey   String   @unique @db.VarChar(160)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([orderId])
}
